---
import Base from '../layouts/Base.astro';

const eduUrl = 'https://edu.washuemsim.org';
const intelUrl = 'https://intel.washuemsim.org';

const programs = [
  {
    href: eduUrl,
    host: 'edu.washuemsim.org',
    kicker: 'Residents & faculty',
    name: 'Simulation Education',
    blurb:
      'Residency simulation curriculum: modules, case exemplars, case dissections, and the reading library.',
    go: 'Open',
  },
  {
    href: intelUrl,
    host: 'intel.washuemsim.org',
    kicker: 'Sim & safety team',
    name: 'Sim Intelligence',
    blurb:
      'Post-session reports, Latent Safety Threat tracking, follow-up, and search across prior sessions.',
    go: 'Open',
  },
];
---

<Base title="Home">
  <main class="hub">
    <section class="hero wrap">
      <p class="eyebrow">Washington University School of Medicine · Emergency Medicine</p>
      <h1>EM Simulation</h1>
      <p class="lede">
        Internal hub for the Emergency Medicine simulation program. Two tools:
      </p>
    </section>

    <section class="programs wrap" aria-label="Programs">
      {
        programs.map((p) => (
          <a class="program" href={p.href}>
            <span class="program__kicker">{p.kicker}</span>
            <h2>{p.name}</h2>
            <p>{p.blurb}</p>
            <span class="program__go">{p.go}</span>
            <span class="program__host">{p.host}</span>
          </a>
        ))
      }
    </section>
  </main>
</Base>
