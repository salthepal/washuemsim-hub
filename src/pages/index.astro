---
import Base from '../layouts/Base.astro';

const eduUrl = 'https://edu.wuemsim.org';
const intelUrl = 'https://intel.wuemsim.org';

const programs = [
  {
    href: eduUrl,
    host: 'edu.wuemsim.org',
    name: 'WUEM Sim Edu',
    blurb:
      'Residency simulation curriculum: modules, case exemplars, case dissections, and the reading library.',
    go: 'Open',
  },
  {
    href: intelUrl,
    host: 'intel.wuemsim.org',
    name: 'WUEM Sim Intel',
    blurb:
      'Post-session reports, Latent Safety Threat tracking, follow-up, and search across prior sessions.',
    go: 'Open',
  },
];
---

<Base title="Home">
  <main class="hub">
    <section class="hero wrap">
      <p class="lede">
        Internal hub for WUEM Simulation program tools.
      </p>
    </section>

    <section class="programs wrap" aria-label="Programs">
      {
        programs.map((p) => (
          <a class="program" href={p.href}>
            <h2>{p.name}</h2>
            <p>{p.blurb}</p>
            <span class="program__go">{p.go}</span>
            <span class="program__host">{p.host}</span>
          </a>
        ))
      }
    </section>
  </main>
</Base>
